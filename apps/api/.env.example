# apps/api — copy to .env (never commit .env). Validated at boot by src/config/env.ts.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://ecclesios:ecclesios@localhost:5432/ecclesios
# Redis: unused until Phase 7. Object storage (S3_*): used from Phase 5.4 (media).
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ecclesios
S3_SECRET_KEY=ecclesios-dev-secret
S3_BUCKET=ecclesios-media
S3_FORCE_PATH_STYLE=true
# Browser-facing endpoint for presigned URLs, if different from S3_ENDPOINT
# S3_PUBLIC_ENDPOINT=https://media.example.org
MEDIA_URL_TTL_SECONDS=600
# Listener paywall for subscriber-only hymnal media and podcast episodes (D-026, D-029).
# Keep 0 until personal plans exist. (HYMNAL_PAYWALL is the older name and still works.)
LISTENER_PAYWALL=0

# Book payments (D-036). test = built-in test checkout (dev only); hubtel = Hubtel Online Checkout.
PAYMENTS_GATEWAY=test
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_MERCHANT_ACCOUNT=
# Buyers return here after paying; Hubtel posts callbacks to PUBLIC_API_URL/api/public/payments/hubtel/callback
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Auth — in production each secret must be ≥32 chars and random: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-only-access-secret
# Pepper for hashing OTPs, temp tokens and refresh tokens
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_MINUTES=10
# Rate limits (functionality §6): per IP across auth endpoints / per identifier for login, per 15 min
AUTH_RATE_IP_MAX=30
AUTH_RATE_IDENTIFIER_MAX=5
# Set to 1 only behind a reverse proxy you control (so req.ip is the real client IP)
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
