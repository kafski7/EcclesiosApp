{
  "name": "ecclesios",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "pnpm --filter @ecclesios/shared build && pnpm --filter @ecclesios/db generate",
    "db:migrate": "pnpm --filter @ecclesios/shared build && pnpm --filter @ecclesios/db migrate",
    "db:seed": "pnpm --filter @ecclesios/shared build && pnpm --filter @ecclesios/db seed",
    "db:studio": "pnpm --filter @ecclesios/shared build && pnpm --filter @ecclesios/db studio",
    "bundle": "node tools/bundle.mjs pack",
    "db:reset": "pnpm --filter @ecclesios/shared build && pnpm --filter @ecclesios/db reset",
    "db:setup": "pnpm db:migrate && pnpm --filter @ecclesios/db seed"
  },
  "devDependencies": {
    "@ecclesios/config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
