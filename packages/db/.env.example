# packages/db — used by drizzle-kit, migrate and seed. Copy to .env (never commit .env)
DATABASE_URL=postgres://ecclesios:ecclesios@localhost:5432/ecclesios
# Seeding wipes the database. It refuses to run against a non-local host unless this is set to 1.
SEED_ALLOW_REMOTE=0
# Password given to every seeded dev account
SEED_DEV_PASSWORD=Ecclesios#2026
