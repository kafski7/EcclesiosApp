{
  "name": "@ecclesios/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, drizzle-kit migrations and dev seeds (blueprint \u00a77).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "reset": "tsx src/seed/index.ts --wipe-only",
    "studio": "drizzle-kit studio",
    "bible:import": "tsx src/bible/import.ts"
  },
  "dependencies": {
    "@ecclesios/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@ecclesios/config": "workspace:*",
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.12.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
