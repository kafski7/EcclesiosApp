{
  "name": "@ecclesios/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/esm/index.d.ts",
        "require": "./dist/cjs/index.d.ts"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./domain": {
      "types": {
        "import": "./dist/esm/domain/index.d.ts",
        "require": "./dist/cjs/domain/index.d.ts"
      },
      "import": "./dist/esm/domain/index.js",
      "require": "./dist/cjs/domain/index.js",
      "default": "./dist/esm/domain/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"fs.mkdirSync('dist/cjs', {recursive: true}); fs.writeFileSync('dist/cjs/package.json', '{\\\"type\\\": \\\"commonjs\\\"}')\"",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ecclesios/config": "workspace:*",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
